[Unit]
Description=Keep Alienware ALC289 woofer output enabled
After=pipewire.service wireplumber.service pipewire-pulse.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
ExecStart=%h/.local/bin/alienware-woofer-watch
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
